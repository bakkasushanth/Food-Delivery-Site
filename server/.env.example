# ============================================================
# SERVER
# ============================================================

# Port the Express server listens on.
PORT=8080

# ============================================================
# DATABASE
# ============================================================

# MongoDB connection string.
# Local example:  mongodb://localhost:27017/foodeli
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/foodeli?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/foodeli

# ============================================================
# AUTH
# ============================================================

# Secret used to sign and verify JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT=replace_with_a_long_random_string

